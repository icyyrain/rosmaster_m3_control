<?xml version="1.0"?>
<package format="3">
  <name>m3pro_arm_bridge</name>
  <version>0.1.0</version>
  <description>Standard ROS 2 state bridge for the ROSMASTER M3 Pro arm.</description>
  <maintainer email="devnull@example.com">M3 Pro extension maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>arm_msgs</exec_depend>
  <exec_depend>m3pro_arm_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
