+static uint8_t feedback_joint_id = ARM_ID_1;
+static uint16_t feedback_sequence = 0;
+
+
+static void Arm_Feedback_Poll(void)
+{
+    int16_t angle = Arm_Get_Angle(feedback_joint_id);
+
+    switch (feedback_joint_id)
+    {
+        case ARM_ID_1: arm_feedback_msg.joint1 = angle; break;
+        case ARM_ID_2: arm_feedback_msg.joint2 = angle; break;
+        case ARM_ID_3: arm_feedback_msg.joint3 = angle; break;
+        case ARM_ID_4: arm_feedback_msg.joint4 = angle; break;
+        case ARM_ID_5: arm_feedback_msg.joint5 = angle; break;
+        case ARM_ID_6: arm_feedback_msg.joint6 = angle; break;
+        default: break;
+    }
+
+    feedback_joint_id++;
+    if (feedback_joint_id > ARM_ID_6)
+    {
+        /* ArmJoints has no header/sequence field. Reuse time as a monotonic
+         * sweep counter on this feedback-only topic; commands still keep their
+         * original duration semantics on /arm6_joints. */
+        arm_feedback_msg.time = (int16_t)(feedback_sequence++ & 0x7FFF);
+        if (rcl_publish(&arm_feedback_publisher, &arm_feedback_msg, NULL) != RCL_RET_OK)
+        {
+            printf("Failed to publish arm feedback.\n");
+        }
+        feedback_joint_id = ARM_ID_1;
+    }
+}
